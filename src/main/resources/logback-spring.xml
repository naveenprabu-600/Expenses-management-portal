<?xml version="1.0" encoding="UTF-8"?>
<!--
  One JSON object per line on stdout, ready for Filebeat.

  Every line carries the request ID and, once signed in, the user (both from the
  MDC), plus the app and environment names, so a log search can be narrowed to
  this service and to a single request.

  Caller data (file and line on every line) costs a stack walk per log call, so
  it is off unless LOG_CALLER_DATA=true.
-->
<configuration>
  <springProperty scope="context" name="APP_ENV" source="expense.env" defaultValue="local"/>

  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeContext>false</includeContext>
      <customFields>{"app":"expense-portal-api","env":"${APP_ENV}"}</customFields>
      <includeCallerData>${LOG_CALLER_DATA:-false}</includeCallerData>
    </encoder>
  </appender>

  <logger name="org.hibernate.orm.deprecation" level="ERROR"/>

  <root level="INFO">
    <appender-ref ref="JSON"/>
  </root>
</configuration>
