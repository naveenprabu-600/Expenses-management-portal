# Copy to .env and fill in. Never commit .env.

# Environment name: lower case letters only. It names the log data stream
# (logs-expenseportal-<APP_ENV>) and is added to every log line.
APP_ENV=dev

# Where the web app listens. Keep it on an internal address: this is a
# demonstration system and is not hardened for internet exposure.
WEB_BIND=127.0.0.1
WEB_PORT=8180

# Database password, used by both the database and the API.
DB_PASSWORD=

# Signs the access tokens. At least 32 characters, e.g.: openssl rand -base64 48
EXPENSE_JWT_SECRET=

# The password every seeded demo account (alice, priya.raman, mark, nina,
# fiona) gets when the database is first created or reset.
DEMO_USER_PASSWORD=

# Elasticsearch for the log shipper, and its write-only API key (id:api_key)
# for logs-expenseportal-*.
ELASTICSEARCH_HOSTS=http://elasticsearch.example:9200
ELASTICSEARCH_API_KEY=
